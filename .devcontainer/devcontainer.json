{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile.dev",
    "options": [
      "--secret",
      "id=ca_cert,src=.devcontainer/certs/corp-ca.crt"
    ]
  },
  "containerEnv": {
    "GPG_TTY": "/dev/tty",
    "NODE_EXTRA_CA_CERTS": "/usr/local/share/ca-certificates/host/corp-ca.crt",
    "REQUESTS_CA_BUNDLE": "/usr/local/share/ca-certificates/host/corp-ca.crt",
    "SSL_CERT_FILE": "/usr/local/share/ca-certificates/host/corp-ca.crt"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "ms-azuretools.vscode-docker",
        "yoavbls.pretty-ts-errors",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "m-p-p.zeek",
        "mechatroner.rainbow-csv",
        "tamasfe.even-better-toml",
        "emilast.LogFileHighlighter",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.analysis.typeCheckingMode": "basic",
        "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/certs,target=/usr/local/share/ca-certificates/host,type=bind,consistency=cached"
  ],
  "name": "EleVADR",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "elevadr",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace"
}
