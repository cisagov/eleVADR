
FROM cisagov/elevadr-web-backend:develop

USER root

# Copy certs (expect the PEM file(s) in .devcontainer/certs/)
COPY .devcontainer/certs/ /tmp/certs/

# If you have multiple files, we concatenate into one bundle for apk.
RUN set -eu && \
    if [ -n "$(ls -A /tmp/certs 2>/dev/null)" ]; then \
      mkdir -p /usr/local/share/ca-certificates/ && \
      cat /tmp/certs/* > /usr/local/share/ca-certificates/custom-bundle.crt && \
      apt-get update && \
      apt-get install -y --no-install-recommends \
        ca-certificates && update-ca-certificates; \
    fi

# Install development essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    vim \
    sudo \
    gpg \
    openssh-client \
    locales \
    build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    locale-gen en_US.UTF-8 && update-locale LANG=en_US.UTF-8

RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | \
    gpg --dearmor -o /etc/apt/keyrings/docker.gpg

RUN echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
  https://download.docker.com/linux/debian bookworm stable" \
  > /etc/apt/sources.list.d/docker.list

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        docker-compose-plugin && \
    rm -rf /var/lib/apt/lists/*


# Give the appuser sudo access so you can install things while developing
RUN echo "appuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch back to your non-privileged user
USER appuser

RUN echo "export PATH=\$HOME/.local/bin:\$PATH" >> ~/.bashrc
RUN echo "export PATH=/usr/libexec/docker/cli-plugins:\$PATH" >> ~/.bashrc

COPY pyproject.toml uv.lock ./

RUN set -eu && \
    if [ -n "$(ls -A /tmp/certs 2>/dev/null)" ]; then \
      echo "export SSL_CERT_FILE=/usr/local/share/ca-certificates/custom-bundle.crt" >> ~/.bashrc && \
      SSL_CERT_FILE=/usr/local/share/ca-certificates/custom-bundle.crt uv sync; \
    else \
      uv sync; \
    fi

# COPY requirements*.txt .

# RUN pip3 install --upgrade -r requirements.txt && pip3 install -r requirements-dev.txt && pip3 install -r requirements-test.txt
