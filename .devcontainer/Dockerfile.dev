FROM ubuntu:26.04

USER root

# Combine packages installation and configure locale in a single layer
RUN apt-get update && apt-get install --no-install-recommends -y \
        ca-certificates \
        curl \
        gnupg2 \
        lsb-release \
        wget \
        software-properties-common \
        git \
        gh \
        vim \
        sudo \
        openssh-client \
        locales \
        build-essential \
    && add-apt-repository -y universe \
    && sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI and Compose Plugin inside container with CA handling
RUN --mount=type=secret,id=ca_cert,required=false \
    set -eu; \
    CERT_INSTALLED=0; \
    if [ -s /run/secrets/ca_cert ]; then \
        cp /run/secrets/ca_cert /usr/local/share/ca-certificates/corp-ca.crt; \
        update-ca-certificates; \
        CERT_INSTALLED=1; \
    fi; \
    . /etc/os-release; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
    gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
        https://download.docker.com/linux/ubuntu ${VERSION_CODENAME} stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        docker.io docker-compose-plugin \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && if [ "$CERT_INSTALLED" -eq 1 ]; then \
        rm -f /usr/local/share/ca-certificates/corp-ca.crt; \
        update-ca-certificates --fresh; \
    fi

# Create non-root developer user
RUN useradd -m -s /bin/bash elevadr \
    && echo "elevadr ALL=(ALL) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt, /usr/sbin/update-ca-certificates" \
        > /etc/sudoers.d/elevadr \
    && chmod 0440 /etc/sudoers.d/elevadr

# Copy tooling from official images cleanly
COPY --link --from=zeek/zeek:8.0.5 /usr/local/zeek /usr/local/zeek
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
COPY --link --from=ghcr.io/pnpm/pnpm:11 /opt/pnpm /usr/local/bin/

# Copy cargo & rustup completely to ensure toolchain functions correctly
COPY --link --from=rust:slim-trixie /usr/local/cargo /usr/local/cargo
COPY --link --from=rust:slim-trixie /usr/local/rustup /usr/local/rustup

# Environment configurations
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH="/usr/local/zeek/bin:/usr/local/cargo/bin:${PATH}"
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV LANG=en_US.UTF-8
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV NVM_DIR=/home/elevadr/.nvm

USER elevadr
WORKDIR /workspace

EXPOSE 8000
CMD ["sleep", "infinity"]
