# Example eleVADR platform configuration. This file documents the
# supported settings and contains NO real secrets.
#
# Do not copy this file to .elevadr-platform.env by hand. Running
# setup_elevadr_database.bat (or first_run_elevadr.bat) generates
# .elevadr-platform.env with random credentials. Never commit that file.

# --- Generated by setup_elevadr_database.bat ---
ELEVADR_MONGO_ROOT_USERNAME=elevadr_root
ELEVADR_MONGO_ROOT_PASSWORD=<generated>
ELEVADR_MONGO_PORT=27017
ELEVADR_MONGODB_URI=<generated>
ELEVADR_MONGODB_DATABASE=elevadr
ELEVADR_JWT_SECRET=<generated>
ELEVADR_JWT_ALGORITHM=HS256

# --- Set to true by first_run_elevadr.bat after the first administrator exists ---
ELEVADR_AUTH_ENABLED=true

# --- Optional settings (documented defaults) ---
ELEVADR_JWT_EXPIRE_MINUTES=60
ELEVADR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ELEVADR_MAX_PCAP_UPLOAD_MB=256
# 0 disables automatic PCAP expiry / storage quota enforcement
ELEVADR_PCAP_RETENTION_DAYS=0
ELEVADR_PCAP_STORAGE_LIMIT_GB=0
# Set only to create encrypted backups (same value is needed to restore)
ELEVADR_BACKUP_PASSPHRASE=
