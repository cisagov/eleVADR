# eleVADR platform settings (do not commit real secrets)
# Generate a complete file with: python -m backend.auth.local_runtime init
# On Windows, setup_elevadr_database.bat runs that and starts MongoDB, and
# first_run_elevadr.bat creates the first admin and turns auth on.
# Every setting is described in docker/README.md.

# MongoDB root account, created on first start of the container.
ELEVADR_MONGO_ROOT_USERNAME=elevadr_root
ELEVADR_MONGO_ROOT_PASSWORD=
ELEVADR_MONGO_PORT=27017

# Used when running backend outside Docker. Compose builds its own URI for the
# backend service using the root account above.
# Compose forces auth on for the backend container. first_run_elevadr.bat sets
# this to true locally once an admin exists.
ELEVADR_AUTH_ENABLED=false
ELEVADR_MONGODB_URI=mongodb://127.0.0.1:27017
ELEVADR_MONGODB_DATABASE=elevadr
# 32 or more characters. Changing it signs everyone out.
ELEVADR_JWT_SECRET=
# Only HS256 is accepted.
ELEVADR_JWT_ALGORITHM=HS256
ELEVADR_JWT_EXPIRE_MINUTES=60
# Vite dev server origins. The container UI on port 8080 proxies /api and /auth
# through nginx, so it does not need an entry here.
ELEVADR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ELEVADR_MAX_PCAP_UPLOAD_MB=256
# 0 disables automatic PCAP expiry and the storage cap.
ELEVADR_PCAP_RETENTION_DAYS=0
ELEVADR_PCAP_STORAGE_LIMIT_GB=0
# Optional. When set, backups are AES-GCM encrypted .evbackup archives and the
# same value is needed to restore them.
ELEVADR_BACKUP_PASSPHRASE=

# Optional. Creates the first administrator when the users collection is empty.
ELEVADR_BOOTSTRAP_ADMIN_USERNAME=admin
# 12 or more characters.
ELEVADR_BOOTSTRAP_ADMIN_PASSWORD=
# Optional. Uncomment to update the admin password on start when it differs from the value above.
# ELEVADR_BOOTSTRAP_ADMIN_SYNC=true

# Optional, backend outside Docker only. Defaults are shown.
# ELEVADR_STORAGE_ROOT=<repo>/storage
# Zeek executable to use instead of searching PATH.
# ELEVADR_ZEEK_COMMAND=
# Used when Zeek is not on PATH and Docker is available.
# ELEVADR_ZEEK_DOCKER_IMAGE=zeek/zeek:9.0.0
# ELEVADR_EVIDENCE_TTL_SECONDS=7200
# ELEVADR_FINISHED_JOB_TTL_SECONDS=300
# ELEVADR_EVIDENCE_CACHE_ROOT=<temp dir>/elevadr-zeek-evidence-cache
