# eleVADR platform settings (do not commit real secrets)
# Generate a complete file with: python -m backend_bryan.auth.local_runtime init
# See docker/mongodb/README.md.

# MongoDB root account, created on first start of the container.
ELEVADR_MONGO_ROOT_USERNAME=elevadr_root
ELEVADR_MONGO_ROOT_PASSWORD=
ELEVADR_MONGO_PORT=27017

# Used when running backend_bryan outside Docker. Compose builds its own URI for the
# backend-bryan service using the root account above.
ELEVADR_AUTH_ENABLED=false
ELEVADR_MONGODB_URI=mongodb://127.0.0.1:27017
ELEVADR_MONGODB_DATABASE=elevadr
ELEVADR_JWT_SECRET=
ELEVADR_JWT_EXPIRE_MINUTES=60
ELEVADR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ELEVADR_MAX_PCAP_UPLOAD_MB=256
ELEVADR_PCAP_RETENTION_DAYS=0
ELEVADR_PCAP_STORAGE_LIMIT_GB=0
# Optional. When set, backups are AES-GCM encrypted .evbackup archives.
ELEVADR_BACKUP_PASSPHRASE=

# Optional. Creates the first administrator when the users collection is empty.
ELEVADR_BOOTSTRAP_ADMIN_USERNAME=admin
ELEVADR_BOOTSTRAP_ADMIN_PASSWORD=
