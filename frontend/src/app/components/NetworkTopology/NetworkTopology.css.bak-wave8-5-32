}
:root[data-theme="dark"] .topology-toolbar,
:root[data-theme="dark"] .topology-card {
  background: #0b1e2a;
  border-color: #304b5d;
}
:root[data-theme="dark"] .topology-toggle-group {
  background: #0d2533;
  border-color: #304b5d;
}
:root[data-theme="dark"] .topology-toolbar > label,
:root[data-theme="dark"] .topology-toggle-group label {
