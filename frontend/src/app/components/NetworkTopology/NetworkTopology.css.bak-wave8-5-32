}
:root[data-theme="dark"] .topology-toolbar input,
:root[data-theme="dark"] .topology-toolbar select {
  background: #102735;
  border-color: #345366;
  color: #d5e4ed;
}
:root[data-theme="dark"] .topology-zoom-controls button {
