}
:root[data-theme="dark"] .topology-node .node-ring {
  fill: #102735;
}
:root[data-theme="dark"] .topology-node-label rect {
  fill: rgba(13, 37, 51, 0.96);
  stroke: #3a5667;
}
:root[data-theme="dark"] .topology-node-label text {
  fill: #d5e4ed;
  stroke: #0d2533;
}

/* Graph selection interaction repair -------------------------------------- */
/* Keep keyboard focus visible through the node ring/edge stroke only; SVG
   focus outlines otherwise render as large blue bounding boxes. */
.topology-node:focus,
.topology-node:focus-visible,
.topology-edge:focus,
.topology-edge:focus-visible {
  outline: none !important;
  box-shadow: none !important;
}

.topology-selection-actions .topology-filter-action[aria-pressed="true"] {
  background: #e8f4f9;
  border-color: #8fbfd4;
  color: #075d85;
}
:root[data-theme="dark"]
  .topology-selection-actions
  .topology-filter-action[aria-pressed="true"] {
  background: #15394c;
  border-color: #47788f;
  color: #a8dff2;
}

/* Option 1 topology layout -------------------------------------------------
   One horizontal control deck keeps view, filters, refinements and graph
   actions in one predictable place while leaving the canvas as the focus. */
.topology-overview-row {
  padding: 0 0 10px;
}
.topology-toolbar-option1 {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid #d8e4ec;
  border-left: 0;
  border-right: 0;
  background: #f8fafc;
  flex-wrap: wrap;
}
.topology-toolbar-option1 .topology-toolbar-group {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  min-width: 0;
}
.topology-toolbar-option1 .topology-toolbar-label,
.topology-toolbar-option1 label > span {
  display: block;
  margin-bottom: 4px;
  color: #6b8295;
  font-size: var(--text-xs);
  font-weight: 800;
  letter-spacing: 0.02em;
}
.topology-filter-group {
  flex: 1 1 520px;
}
.topology-filter-group > label {
  display: block;
  min-width: 100px;
}
.topology-filter-group .topology-search {
  flex: 1 1 170px;
}
.topology-filter-group > label:not(.topology-search) {
  flex: 0 1 145px;
}
.topology-filter-group .topology-view-mode,
.topology-filter-group .topology-label-mode {
  flex: 0 0 128px;
}
.topology-filter-group input,
.topology-filter-group select {
  width: 100%;
  height: 32px;
  padding: 0 8px;
  border: 1px solid #cbdce6;
  border-radius: 0;
  background: #fff;
  color: #234e69;
  font-size: var(--text-xs);
}
.topology-refinement-group {
  flex: 1 1 100%;
  align-items: center !important;
  padding-top: 2px;
  gap: 6px !important;
}
.topology-refinement-group label {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 30px;
  padding: 4px 8px;
  border: 1px solid #d5e0e7;
  background: #fff;
  color: #587286;
  font-size: var(--text-xs);
  font-weight: 750;
  white-space: nowrap;
  cursor: pointer;
}
.topology-refinement-group label.active {
  border-color: #8fb9ce;
  background: #edf6fa;
  color: #0d668e;
}
.topology-refinement-group label:has(input:disabled) {
  opacity: 0.45;
  cursor: not-allowed;
}
.topology-refinement-group input {
  margin: 0;
  accent-color: #005ea8;
}
.topology-toolbar-option1 .topology-zoom-controls {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  flex: 0 0 auto;
}
.topology-toolbar-option1 .topology-zoom-controls button {
  height: 32px;
  min-width: 32px;
  padding: 0 8px;
  border-radius: 0;
}

/* Compact, collapsible in-canvas legend. */
.topology-legend {
  left: 12px;
  right: auto;
  bottom: 12px;
  width: min(250px, calc(100% - 24px));
  display: block;
  padding: 0;
  border-radius: 4px;
  overflow: hidden;
}
.topology-legend-toggle {
  width: 100%;
  min-height: 31px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 5px 9px;
  border: 0;
  background: rgba(255, 255, 255, 0.96);
  color: #315b75;
  font-size: var(--text-xs);
  font-weight: 850;
  cursor: pointer;
}
.topology-legend-items {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 10px;
  padding: 8px 9px 9px;
  border-top: 1px solid #e0e8ed;
}
.topology-legend-items span {
  min-width: 0;
}
.topology-legend-items .legend-hint {
  grid-column: 1/-1;
  margin: 3px 0 0;
  padding-top: 6px;
  border-top: 1px solid #e6edf1;
  line-height: 1.35;
}
.topology-legend.collapsed {
  width: 86px;
}

:root[data-theme="dark"] .topology-toolbar-option1 {
  background: #0d2533;
  border-color: #304b5d;
}
:root[data-theme="dark"] .topology-filter-group input,
:root[data-theme="dark"] .topology-filter-group select,
:root[data-theme="dark"] .topology-refinement-group label {
  background: #102735;
  border-color: #345366;
  color: #d5e4ed;
}
:root[data-theme="dark"] .topology-refinement-group label.active {
  background: #15394c;
  border-color: #37617a;
  color: #8fd4ef;
}
:root[data-theme="dark"] .topology-legend-toggle {
  background: rgba(13, 37, 51, 0.97);
  color: #d5e4ed;
}
:root[data-theme="dark"] .topology-legend-items {
  border-color: #304b5d;
}

@media (max-width: 1180px) {
  .topology-toolbar-option1 {
    align-items: stretch;
  }
  .topology-filter-group {
    flex: 1 1 100%;
  }
  .topology-toolbar-option1 .topology-zoom-controls {
    margin-left: 0;
  }
}
@media (max-width: 760px) {
  .topology-toolbar-option1 {
    display: grid;
    grid-template-columns: 1fr;
    padding: 9px;
  }
  .topology-filter-group,
  .topology-refinement-group {
    width: 100%;
    flex-wrap: wrap;
  }
  .topology-filter-group > label {
    flex: 1 1 calc(50% - 6px);
  }
  .topology-filter-group .topology-search {
    flex-basis: 100%;
  }
  .topology-toolbar-option1 .topology-zoom-controls {
    width: 100%;
    justify-content: flex-start;
    flex-wrap: wrap;
  }
}
@media (max-width: 520px) {
  .topology-filter-group > label {
    flex-basis: 100%;
  }
  .topology-refinement-group label {
    flex: 1 1 calc(50% - 6px);
    white-space: normal;
  }
  .topology-legend {
    left: 8px;
    bottom: 8px;
    width: min(230px, calc(100% - 16px));
  }
}

/* Topology interaction repair: keep edges easy to select without changing their appearance. */
.topology-edge-hit {
  stroke: transparent !important;
  stroke-opacity: 0 !important;
  pointer-events: stroke;
  fill: none;
}
.topology-edge-visible {
  pointer-events: none;
}

/* Option 1 cleanup: summary cards were removed; the toolbar is now the first topology control surface. */
.topology-card > .topology-toolbar {
  border-top: 0;
}

/* Keep visibility refinements and graph actions on one shared row. */
.topology-toolbar-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex: 1 1 100%;
  min-width: 0;
}
.topology-toolbar-bottom-row .topology-refinement-group {
  flex: 0 1 auto;
  padding-top: 0;
  flex-wrap: wrap;
}
.topology-toolbar-bottom-row .topology-zoom-controls {
  margin-left: auto;
  flex: 0 0 auto;
}
@media (max-width: 900px) {
  .topology-toolbar-bottom-row {
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .topology-toolbar-bottom-row .topology-zoom-controls {
    margin-left: auto;
  }
}
@media (max-width: 620px) {
  .topology-toolbar-bottom-row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .topology-toolbar-bottom-row .topology-zoom-controls {
    margin-left: 0;
    justify-content: flex-start;
    flex-wrap: wrap;
  }
}

/* Click a node to select it; drag from anywhere on the node to move it. */
.topology-node { cursor: grab; touch-action: none; }
.topology-node:active { cursor: grabbing; }
.topology-node .node-hit { fill: transparent; stroke: none; pointer-events: all; }

/* Expansion is confined to the report's right content panel, not the browser viewport. */
.topology-card--expanded { width: 100%; height: min(85vh, 1100px); max-width: 100%; }
.topology-card--expanded .topology-canvas { flex: 1 1 auto; min-height: 320px; }

/* Expanded topology is a right-workspace overlay, not a taller in-flow card.
   This covers the other report sections while leaving the app title bar and
   report navigation usable. */
.app-shell .topology-card--expanded {
  position: fixed;
  top: var(--titlebar-height, 68px);
  bottom: 0;
  left: var(--sidebar-width, 238px);
  right: 0;
  z-index: 30;
  width: auto;
  max-width: none;
  height: auto;
  max-height: none;
  margin: 0;
  border: 0;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--surface, #fff);
  box-shadow: -3px 0 16px rgba(0, 0, 0, .10);
}
.sidebar-is-collapsed .topology-card--expanded {
  left: var(--sidebar-collapsed-width, 72px);
}
.app-shell .topology-card--expanded .topology-canvas {
  flex: 1 1 auto;
  height: auto;
  min-height: 0;
  overflow: hidden;
}
