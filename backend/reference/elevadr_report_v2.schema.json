{
  "$id": "https://elevadr.local/schemas/elevadr-report-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "arch_insights": {
      "type": "object"
    },
    "executive_summary": {
      "type": "object"
    },
    "modules": {
      "properties": {
        "connection_success_panel": {
          "type": "object"
        },
        "device_panel": {
          "type": "object"
        },
        "edge_devices": {
          "type": "array"
        },
        "it_devices": {
          "type": "array"
        },
        "ot_cross_segment_lines_panel": {
          "type": "object"
        },
        "ot_devices": {
          "type": "array"
        },
        "ot_services": {
          "type": "array"
        },
        "service_count_panel": {
          "type": "object"
        },
        "service_panel": {
          "type": "object"
        },
        "service_risk_breakdown_panel": {
          "type": "object"
        },
        "suspicious_outbound_connections_panel": {
          "type": "array"
        }
      },
      "required": [
        "service_panel",
        "device_panel",
        "service_risk_breakdown_panel",
        "service_count_panel",
        "connection_success_panel",
        "suspicious_outbound_connections_panel",
        "ot_cross_segment_lines_panel",
        "ot_devices",
        "it_devices",
        "edge_devices",
        "ot_services"
      ],
      "type": "object"
    },
    "report_id": {
      "minLength": 1,
      "type": "string"
    },
    "report_version": {
      "pattern": "^2\\.",
      "type": "string"
    }
  },
  "required": [
    "report_version",
    "report_id",
    "executive_summary",
    "modules",
    "arch_insights"
  ],
  "title": "eleVADR canonical report v2",
  "type": "object"
}
