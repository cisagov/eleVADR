{
  "$id": "urn:elevadr:detection-context:analysis-response:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "elevadr.detection-context.analysis-response.v1"
    },
    "errors": {
      "items": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "moduleId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "moduleResults": {
      "items": {
        "required": [
          "module_id",
          "findings",
          "metrics",
          "evidence",
          "warnings"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "summary": {
      "properties": {
        "completedModules": {
          "minimum": 0,
          "type": "integer"
        },
        "failedModules": {
          "minimum": 0,
          "type": "integer"
        },
        "findingCount": {
          "minimum": 0,
          "type": "integer"
        },
        "requestedModules": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "requestedModules",
        "completedModules",
        "failedModules",
        "findingCount"
      ],
      "type": "object"
    }
  },
  "required": [
    "contractVersion",
    "status",
    "summary",
    "moduleResults",
    "errors"
  ],
  "title": "DetectionAnalysisResponse v1",
  "type": "object"
}
